{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alharam.local/schemas/tables/TaxRules.schema.json",
  "title": "TaxRules",
  "description": "Configurable tax rules. NO CLASSIFICATION IS NAMED OR ASSUMED before the accountant confirms it in writing (D-08).",
  "x-description-ar": "قواعد الضريبة القابلة للتهيئة",
  "x-category": "master",
  "x-scope": "global",
  "x-sensitivity": "financial",
  "x-built-in-phase": 6,
  "x-primary-key": "TaxRuleID",
  "x-content-hash-fields": [],
  "x-unique-together": [],
  "x-at-least-one": [],
  "x-notes": [],
  "type": "object",
  "properties": {
    "TaxRuleID": {
      "type": "string"
    },
    "TaxRuleCode": {
      "type": "string",
      "x-source": "config"
    },
    "NameEN": {
      "type": "string",
      "x-source": "config",
      "x-bilingual-pair": "NameAR"
    },
    "NameAR": {
      "type": "string",
      "x-source": "config",
      "x-language": "ar"
    },
    "TreatmentLabel": {
      "type": "string",
      "enum": [
        "PENDING_ACCOUNTANT_CONFIRMATION",
        "SYNTHETIC_TEST_ONLY"
      ],
      "x-enum": "TaxTreatmentPlaceholder",
      "x-source": "config",
      "description": "'Zero-rated', 'exempt', 'out of scope' and 'no tax configured' are distinct and non-interchangeable. None may be recorded here without written confirmation (D-08)."
    },
    "RatePercent": {
      "type": "string",
      "x-decimal-scale": 4,
      "x-storage": "decimal string; never a float (spec 11)",
      "x-source": "config",
      "description": "Validation: Null until confirmed. Null means 'unknown', never 'zero'."
    },
    "AppliesToCountry": {
      "type": "string",
      "x-source": "config"
    },
    "EffectiveFrom": {
      "type": "string",
      "x-source": "config"
    },
    "EffectiveTo": {
      "type": "string",
      "x-source": "config"
    },
    "Version": {
      "type": "integer",
      "x-source": "system",
      "description": "The rule AND its version are preserved on every invoice calculation (D-08)."
    },
    "ConfirmedByAccountant": {
      "type": "boolean",
      "x-source": "user",
      "description": "Production invoicing is blocked while FALSE."
    },
    "ConfirmationReference": {
      "type": "string",
      "x-source": "user",
      "description": "Reference to the accountant's written confirmation. No document content stored."
    },
    "IsActive": {
      "type": "boolean",
      "x-source": "user",
      "description": "Soft delete. Rows are never hard-deleted; history is evidence."
    },
    "CreatedAt": {
      "type": "string",
      "x-source": "system",
      "description": "UTC. Set once on insert."
    },
    "CreatedBy": {
      "type": "string",
      "x-source": "system",
      "description": "USEREMAIL() or the service identity."
    },
    "UpdatedAt": {
      "type": "string",
      "x-source": "system",
      "description": "UTC. Excluded from ContentHash."
    },
    "UpdatedBy": {
      "type": "string",
      "x-source": "system"
    }
  },
  "required": [
    "TaxRuleID",
    "TaxRuleCode",
    "NameEN",
    "NameAR",
    "TreatmentLabel",
    "EffectiveFrom",
    "Version",
    "ConfirmedByAccountant",
    "IsActive",
    "CreatedAt",
    "CreatedBy",
    "UpdatedAt",
    "UpdatedBy"
  ],
  "additionalProperties": false
}
