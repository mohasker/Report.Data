{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alharam.local/schemas/tables/BOQItems.schema.json",
  "title": "BOQItems",
  "description": "Bill of quantities. Cumulative quantity is controlled, never merely recorded.",
  "x-description-ar": "بنود جدول الكميات",
  "x-category": "financial",
  "x-scope": "project",
  "x-sensitivity": "financial",
  "x-built-in-phase": 6,
  "x-primary-key": "BOQItemID",
  "x-content-hash-fields": [],
  "x-unique-together": [
    [
      "ContractID",
      "ItemNumber"
    ]
  ],
  "x-at-least-one": [],
  "x-notes": [],
  "type": "object",
  "properties": {
    "BOQItemID": {
      "type": "string"
    },
    "ContractID": {
      "type": "string",
      "x-references": "Contracts.ContractID",
      "x-source": "user",
      "description": "References Contracts.ContractID"
    },
    "ProjectID": {
      "type": "string",
      "x-references": "Projects.ProjectID",
      "x-source": "system",
      "description": "References Projects.ProjectID"
    },
    "ItemNumber": {
      "type": "string",
      "x-source": "user"
    },
    "DescriptionEN": {
      "type": "string",
      "x-source": "user",
      "x-bilingual-pair": "DescriptionAR"
    },
    "DescriptionAR": {
      "type": "string",
      "x-source": "user",
      "x-language": "ar"
    },
    "UnitID": {
      "type": "string",
      "x-references": "Units.UnitID",
      "x-source": "user",
      "description": "References Units.UnitID"
    },
    "ContractQuantity": {
      "type": "string",
      "x-decimal-scale": 3,
      "x-storage": "decimal string; never a float (spec 11)",
      "x-source": "user",
      "description": "Validation: >= 0"
    },
    "UnitRate": {
      "type": "string",
      "x-decimal-scale": 3,
      "x-storage": "decimal string; never a float (spec 11)",
      "x-source": "user",
      "description": "Validation: >= 0"
    },
    "ApprovedVariationQuantity": {
      "type": "string",
      "x-decimal-scale": 3,
      "x-storage": "decimal string; never a float (spec 11)",
      "x-source": "user"
    },
    "PreviouslyCertifiedQuantity": {
      "type": "string",
      "x-decimal-scale": 3,
      "x-storage": "decimal string; never a float (spec 11)",
      "x-source": "system"
    },
    "CurrentQuantity": {
      "type": "string",
      "x-decimal-scale": 3,
      "x-storage": "decimal string; never a float (spec 11)",
      "x-source": "system"
    },
    "CumulativeQuantity": {
      "type": "string",
      "x-decimal-scale": 3,
      "x-storage": "decimal string; never a float (spec 11)",
      "x-source": "system",
      "description": "Computed. Must not exceed ContractQuantity + ApprovedVariationQuantity without a recorded authorised override (spec 5.17)."
    },
    "RemainingQuantity": {
      "type": "string",
      "x-decimal-scale": 3,
      "x-storage": "decimal string; never a float (spec 11)",
      "x-source": "system",
      "description": "Computed."
    },
    "QuickBooksItemID": {
      "type": "string",
      "x-source": "integration",
      "description": "Immutable accounting item identifier. Never name-matched."
    },
    "IsActive": {
      "type": "boolean",
      "x-source": "user",
      "description": "Soft delete. Rows are never hard-deleted; history is evidence."
    },
    "CreatedAt": {
      "type": "string",
      "x-source": "system",
      "description": "UTC. Set once on insert."
    },
    "CreatedBy": {
      "type": "string",
      "x-source": "system",
      "description": "USEREMAIL() or the service identity."
    },
    "UpdatedAt": {
      "type": "string",
      "x-source": "system",
      "description": "UTC. Excluded from ContentHash."
    },
    "UpdatedBy": {
      "type": "string",
      "x-source": "system"
    }
  },
  "required": [
    "BOQItemID",
    "ContractID",
    "ProjectID",
    "ItemNumber",
    "DescriptionEN",
    "UnitID",
    "ContractQuantity",
    "UnitRate",
    "ApprovedVariationQuantity",
    "PreviouslyCertifiedQuantity",
    "CurrentQuantity",
    "CumulativeQuantity",
    "RemainingQuantity",
    "IsActive",
    "CreatedAt",
    "CreatedBy",
    "UpdatedAt",
    "UpdatedBy"
  ],
  "additionalProperties": false
}
