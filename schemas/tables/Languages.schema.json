{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alharam.local/schemas/tables/Languages.schema.json",
  "title": "Languages",
  "description": "Supported languages and their direction. Bilingual capability is architectural (D-11).",
  "x-description-ar": "اللغات المدعومة واتجاه الكتابة",
  "x-category": "vocabulary",
  "x-scope": "global",
  "x-sensitivity": "internal",
  "x-built-in-phase": 1,
  "x-primary-key": "LanguageCode",
  "x-content-hash-fields": [],
  "x-unique-together": [],
  "x-at-least-one": [],
  "x-notes": [],
  "type": "object",
  "properties": {
    "LanguageCode": {
      "type": "string",
      "enum": [
        "en",
        "ar"
      ],
      "x-enum": "Language"
    },
    "NameEN": {
      "type": "string",
      "x-source": "config",
      "x-bilingual-pair": "NameAR"
    },
    "NameAR": {
      "type": "string",
      "x-source": "config",
      "x-language": "ar"
    },
    "Direction": {
      "type": "string",
      "x-source": "config",
      "description": "Validation: LTR|RTL"
    },
    "IsDocumentLanguage": {
      "type": "boolean",
      "x-source": "config",
      "description": "Whether approved templates exist for this language."
    },
    "IsActive": {
      "type": "boolean",
      "x-source": "user",
      "description": "Soft delete. Rows are never hard-deleted; history is evidence."
    },
    "CreatedAt": {
      "type": "string",
      "x-source": "system",
      "description": "UTC. Set once on insert."
    },
    "CreatedBy": {
      "type": "string",
      "x-source": "system",
      "description": "USEREMAIL() or the service identity."
    },
    "UpdatedAt": {
      "type": "string",
      "x-source": "system",
      "description": "UTC. Excluded from ContentHash."
    },
    "UpdatedBy": {
      "type": "string",
      "x-source": "system"
    }
  },
  "required": [
    "LanguageCode",
    "NameEN",
    "NameAR",
    "Direction",
    "IsDocumentLanguage",
    "IsActive",
    "CreatedAt",
    "CreatedBy",
    "UpdatedAt",
    "UpdatedBy"
  ],
  "additionalProperties": false
}
