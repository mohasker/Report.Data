{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alharam.local/schemas/tables/Snags.schema.json",
  "title": "Snags",
  "description": "Defects and observations tracked to closure with evidence.",
  "x-description-ar": "الملاحظات وعدم المطابقات",
  "x-category": "operational",
  "x-scope": "project",
  "x-sensitivity": "confidential",
  "x-built-in-phase": 1,
  "x-primary-key": "SnagID",
  "x-content-hash-fields": [],
  "x-unique-together": [],
  "x-at-least-one": [],
  "x-notes": [],
  "type": "object",
  "properties": {
    "SnagID": {
      "type": "string"
    },
    "ProjectID": {
      "type": "string",
      "x-references": "Projects.ProjectID",
      "x-source": "system",
      "description": "References Projects.ProjectID"
    },
    "LocationID": {
      "type": "string",
      "x-references": "Locations.LocationID",
      "x-source": "user",
      "description": "References Locations.LocationID"
    },
    "VisitID": {
      "type": "string",
      "x-references": "SiteVisits.VisitID",
      "x-source": "system",
      "description": "References SiteVisits.VisitID"
    },
    "VisitActivityID": {
      "type": "string",
      "x-references": "VisitActivities.VisitActivityID",
      "x-source": "system",
      "description": "References VisitActivities.VisitActivityID"
    },
    "SourcePhotoID": {
      "type": "string",
      "x-references": "Photos.PhotoID",
      "x-source": "user",
      "description": "References Photos.PhotoID"
    },
    "Category": {
      "type": "string",
      "x-source": "user"
    },
    "Severity": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High",
        "Critical"
      ],
      "x-enum": "SnagSeverity",
      "x-source": "user"
    },
    "DescriptionEN": {
      "type": "string",
      "x-source": "user",
      "x-bilingual-pair": "DescriptionAR"
    },
    "DescriptionAR": {
      "type": "string",
      "x-source": "user",
      "x-language": "ar"
    },
    "RaisedAt": {
      "type": "string",
      "x-source": "system"
    },
    "RaisedBy": {
      "type": "string",
      "x-references": "Users.UserID",
      "x-source": "system",
      "description": "References Users.UserID"
    },
    "ResponsibleParty": {
      "type": "string",
      "x-source": "user"
    },
    "TargetDate": {
      "type": "string",
      "x-source": "user"
    },
    "Status": {
      "type": "string",
      "enum": [
        "Open",
        "Assigned",
        "InProgress",
        "PendingVerification",
        "Closed",
        "Rejected",
        "Deferred"
      ],
      "x-enum": "SnagStatus",
      "x-source": "user"
    },
    "ClosureDate": {
      "type": "string",
      "x-source": "user",
      "description": "Validation: Required when Status = Closed"
    },
    "ClosureEvidencePhotoID": {
      "type": "string",
      "x-references": "Photos.PhotoID",
      "x-source": "user",
      "description": "A snag cannot be closed on assertion alone. Validation: Required when Status = Closed References Photos.PhotoID"
    },
    "VerifiedBy": {
      "type": "string",
      "x-references": "Users.UserID",
      "x-source": "system",
      "description": "Validation: Required when Status = Closed References Users.UserID"
    },
    "VerificationDate": {
      "type": "string",
      "x-source": "system"
    },
    "IsActive": {
      "type": "boolean",
      "x-source": "user",
      "description": "Soft delete. Rows are never hard-deleted; history is evidence."
    },
    "CreatedAt": {
      "type": "string",
      "x-source": "system",
      "description": "UTC. Set once on insert."
    },
    "CreatedBy": {
      "type": "string",
      "x-source": "system",
      "description": "USEREMAIL() or the service identity."
    },
    "UpdatedAt": {
      "type": "string",
      "x-source": "system",
      "description": "UTC. Excluded from ContentHash."
    },
    "UpdatedBy": {
      "type": "string",
      "x-source": "system"
    }
  },
  "required": [
    "SnagID",
    "ProjectID",
    "LocationID",
    "Category",
    "Severity",
    "DescriptionEN",
    "RaisedAt",
    "RaisedBy",
    "Status",
    "IsActive",
    "CreatedAt",
    "CreatedBy",
    "UpdatedAt",
    "UpdatedBy"
  ],
  "additionalProperties": false
}
