{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alharam.local/schemas/tables/Locations.schema.json",
  "title": "Locations",
  "description": "Hierarchical locations within a project. Choices are always filtered by project (spec 7.3).",
  "x-description-ar": "المواقع ضمن المشروع",
  "x-category": "master",
  "x-scope": "project",
  "x-sensitivity": "confidential",
  "x-built-in-phase": 1,
  "x-primary-key": "LocationID",
  "x-content-hash-fields": [],
  "x-unique-together": [
    [
      "ProjectID",
      "LocationCode"
    ]
  ],
  "x-at-least-one": [],
  "x-notes": [],
  "type": "object",
  "properties": {
    "LocationID": {
      "type": "string"
    },
    "ProjectID": {
      "type": "string",
      "x-references": "Projects.ProjectID",
      "x-source": "user",
      "description": "References Projects.ProjectID"
    },
    "LocationCode": {
      "type": "string",
      "x-source": "user",
      "description": "Validation: Filename-safe; unique within project"
    },
    "LocationNameEN": {
      "type": "string",
      "x-source": "user",
      "x-bilingual-pair": "LocationNameAR"
    },
    "LocationNameAR": {
      "type": "string",
      "x-source": "user",
      "x-language": "ar"
    },
    "ParentLocationID": {
      "type": "string",
      "x-references": "Locations.LocationID",
      "x-source": "user",
      "description": "Supports site > building > floor > room hierarchies (D-15 item 3). Validation: Parent must belong to the SAME project; no cycles; max depth 5 References Locations.LocationID"
    },
    "LocationKind": {
      "type": "string",
      "x-source": "user",
      "description": "Validation: Site|Zone|Building|Floor|Room|Asset"
    },
    "GPSLatitude": {
      "type": "string",
      "x-decimal-scale": 7,
      "x-storage": "decimal string; never a float (spec 11)",
      "x-source": "device",
      "description": "Evidence, not a gate. Missing is recorded as missing, never as zero (C-08)."
    },
    "GPSLongitude": {
      "type": "string",
      "x-decimal-scale": 7,
      "x-storage": "decimal string; never a float (spec 11)",
      "x-source": "device"
    },
    "GeofenceRadiusM": {
      "type": "integer",
      "x-source": "user",
      "description": "Out-of-geofence capture is flagged for the reviewer, never auto-rejected."
    },
    "DisplayOrder": {
      "type": "integer",
      "x-source": "user"
    },
    "IsActive": {
      "type": "boolean",
      "x-source": "user",
      "description": "Soft delete. Rows are never hard-deleted; history is evidence."
    },
    "CreatedAt": {
      "type": "string",
      "x-source": "system",
      "description": "UTC. Set once on insert."
    },
    "CreatedBy": {
      "type": "string",
      "x-source": "system",
      "description": "USEREMAIL() or the service identity."
    },
    "UpdatedAt": {
      "type": "string",
      "x-source": "system",
      "description": "UTC. Excluded from ContentHash."
    },
    "UpdatedBy": {
      "type": "string",
      "x-source": "system"
    }
  },
  "required": [
    "LocationID",
    "ProjectID",
    "LocationCode",
    "LocationNameEN",
    "DisplayOrder",
    "IsActive",
    "CreatedAt",
    "CreatedBy",
    "UpdatedAt",
    "UpdatedBy"
  ],
  "additionalProperties": false
}
