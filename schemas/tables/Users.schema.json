{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alharam.local/schemas/tables/Users.schema.json",
  "title": "Users",
  "description": "People who may sign in. One identity per person — shared accounts destroy attribution.",
  "x-description-ar": "مستخدمو النظام",
  "x-category": "master",
  "x-scope": "global",
  "x-sensitivity": "personal",
  "x-built-in-phase": 1,
  "x-primary-key": "UserID",
  "x-content-hash-fields": [],
  "x-unique-together": [],
  "x-at-least-one": [],
  "x-notes": [
    "Payroll and HR attributes are deliberately absent (spec 5.13)."
  ],
  "type": "object",
  "properties": {
    "UserID": {
      "type": "string"
    },
    "Email": {
      "type": "string",
      "x-source": "user",
      "description": "Normalised to lowercase. The sign-in identity and the audit key."
    },
    "FullNameEN": {
      "type": "string",
      "x-source": "user",
      "x-bilingual-pair": "FullNameAR"
    },
    "FullNameAR": {
      "type": "string",
      "x-source": "user",
      "x-language": "ar",
      "description": "Arabic name preserved without transliteration loss (D-11)."
    },
    "Mobile": {
      "type": "string",
      "x-sensitivity": "personal",
      "x-source": "user"
    },
    "RoleID": {
      "type": "string",
      "x-references": "Roles.RoleID",
      "x-source": "user",
      "description": "References Roles.RoleID"
    },
    "EmployeeID": {
      "type": "string",
      "x-sensitivity": "personal",
      "x-source": "user"
    },
    "DefaultProjectID": {
      "type": "string",
      "x-references": "Projects.ProjectID",
      "x-source": "user",
      "description": "Convenience only. Never a substitute for ProjectAssignments. References Projects.ProjectID"
    },
    "Language": {
      "type": "string",
      "enum": [
        "en",
        "ar"
      ],
      "x-enum": "Language",
      "x-source": "user",
      "description": "Interface and notification language preference (D-11)."
    },
    "LastLoginAt": {
      "type": "string",
      "x-source": "system"
    },
    "IsActive": {
      "type": "boolean",
      "x-source": "user",
      "description": "Soft delete. Rows are never hard-deleted; history is evidence."
    },
    "CreatedAt": {
      "type": "string",
      "x-source": "system",
      "description": "UTC. Set once on insert."
    },
    "CreatedBy": {
      "type": "string",
      "x-source": "system",
      "description": "USEREMAIL() or the service identity."
    },
    "UpdatedAt": {
      "type": "string",
      "x-source": "system",
      "description": "UTC. Excluded from ContentHash."
    },
    "UpdatedBy": {
      "type": "string",
      "x-source": "system"
    }
  },
  "required": [
    "UserID",
    "Email",
    "FullNameEN",
    "RoleID",
    "Language",
    "IsActive",
    "CreatedAt",
    "CreatedBy",
    "UpdatedAt",
    "UpdatedBy"
  ],
  "additionalProperties": false
}
