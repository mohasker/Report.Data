{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alharam.local/schemas/tables/InvoiceLines.schema.json",
  "title": "InvoiceLines",
  "description": "Calculated invoice lines. No figure originates from a language model (invariant I-4).",
  "x-description-ar": "بنود الفاتورة",
  "x-category": "financial",
  "x-scope": "project",
  "x-sensitivity": "financial",
  "x-built-in-phase": 6,
  "x-primary-key": "InvoiceLineID",
  "x-content-hash-fields": [],
  "x-unique-together": [],
  "x-at-least-one": [],
  "x-notes": [],
  "type": "object",
  "properties": {
    "InvoiceLineID": {
      "type": "string"
    },
    "InvoiceRequestID": {
      "type": "string",
      "x-references": "InvoiceRequests.InvoiceRequestID",
      "x-source": "system",
      "description": "References InvoiceRequests.InvoiceRequestID"
    },
    "ProjectID": {
      "type": "string",
      "x-references": "Projects.ProjectID",
      "x-source": "system",
      "description": "References Projects.ProjectID"
    },
    "BOQItemID": {
      "type": "string",
      "x-references": "BOQItems.BOQItemID",
      "x-source": "system",
      "description": "References BOQItems.BOQItemID"
    },
    "LineNumber": {
      "type": "integer",
      "x-source": "system"
    },
    "DescriptionEN": {
      "type": "string",
      "x-source": "user",
      "x-bilingual-pair": "DescriptionAR",
      "description": "AI may draft this human-readable description and nothing else (spec 9.4)."
    },
    "DescriptionAR": {
      "type": "string",
      "x-source": "user",
      "x-language": "ar"
    },
    "Quantity": {
      "type": "string",
      "x-decimal-scale": 3,
      "x-storage": "decimal string; never a float (spec 11)",
      "x-source": "system"
    },
    "UnitRate": {
      "type": "string",
      "x-decimal-scale": 3,
      "x-storage": "decimal string; never a float (spec 11)",
      "x-source": "system"
    },
    "LineAmount": {
      "type": "string",
      "x-decimal-scale": 3,
      "x-storage": "decimal string; never a float (spec 11)",
      "x-source": "calculation",
      "description": "Computed, never entered."
    },
    "TaxCode": {
      "type": "string",
      "x-source": "system"
    },
    "TaxAmount": {
      "type": "string",
      "x-decimal-scale": 3,
      "x-storage": "decimal string; never a float (spec 11)",
      "x-source": "calculation"
    },
    "CostCenter": {
      "type": "string",
      "x-source": "user"
    },
    "Class": {
      "type": "string",
      "x-source": "user",
      "description": "Maps to an accounting class where available."
    },
    "ProjectReference": {
      "type": "string",
      "x-source": "system"
    },
    "CreatedAt": {
      "type": "string",
      "x-source": "system",
      "description": "UTC. Set once on insert."
    },
    "CreatedBy": {
      "type": "string",
      "x-source": "system",
      "description": "USEREMAIL() or the service identity."
    },
    "UpdatedAt": {
      "type": "string",
      "x-source": "system",
      "description": "UTC. Excluded from ContentHash."
    },
    "UpdatedBy": {
      "type": "string",
      "x-source": "system"
    }
  },
  "required": [
    "InvoiceLineID",
    "InvoiceRequestID",
    "ProjectID",
    "LineNumber",
    "DescriptionEN",
    "Quantity",
    "UnitRate",
    "LineAmount",
    "TaxAmount",
    "CreatedAt",
    "CreatedBy",
    "UpdatedAt",
    "UpdatedBy"
  ],
  "additionalProperties": false
}
