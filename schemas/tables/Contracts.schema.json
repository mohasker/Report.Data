{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alharam.local/schemas/tables/Contracts.schema.json",
  "title": "Contracts",
  "description": "Commercial agreement governing a project. Hidden from field roles entirely.",
  "x-description-ar": "العقود",
  "x-category": "financial",
  "x-scope": "project",
  "x-sensitivity": "financial",
  "x-built-in-phase": 6,
  "x-primary-key": "ContractID",
  "x-content-hash-fields": [],
  "x-unique-together": [],
  "x-at-least-one": [],
  "x-notes": [],
  "type": "object",
  "properties": {
    "ContractID": {
      "type": "string"
    },
    "LegalEntityID": {
      "type": "string",
      "x-references": "LegalEntities.LegalEntityID",
      "x-source": "user",
      "description": "References LegalEntities.LegalEntityID"
    },
    "ClientID": {
      "type": "string",
      "x-references": "Clients.ClientID",
      "x-source": "user",
      "description": "References Clients.ClientID"
    },
    "ProjectID": {
      "type": "string",
      "x-references": "Projects.ProjectID",
      "x-source": "user",
      "description": "References Projects.ProjectID"
    },
    "ContractNumber": {
      "type": "string",
      "x-source": "user"
    },
    "EffectiveDate": {
      "type": "string",
      "x-source": "user"
    },
    "ExpiryDate": {
      "type": "string",
      "x-source": "user"
    },
    "Currency": {
      "type": "string",
      "x-source": "user",
      "description": "Validation: ISO 4217; must match the project currency"
    },
    "PaymentTermsDays": {
      "type": "integer",
      "x-source": "user"
    },
    "RetentionPercent": {
      "type": "string",
      "x-decimal-scale": 4,
      "x-storage": "decimal string; never a float (spec 11)",
      "x-source": "user"
    },
    "AdvanceAmount": {
      "type": "string",
      "x-decimal-scale": 3,
      "x-storage": "decimal string; never a float (spec 11)",
      "x-source": "user"
    },
    "AdvanceRecoveryPercent": {
      "type": "string",
      "x-decimal-scale": 4,
      "x-storage": "decimal string; never a float (spec 11)",
      "x-source": "user"
    },
    "TaxRuleID": {
      "type": "string",
      "x-references": "TaxRules.TaxRuleID",
      "x-source": "user",
      "description": "The rule AND its version are preserved on every calculation (D-08). References TaxRules.TaxRuleID"
    },
    "BillingFrequency": {
      "type": "string",
      "enum": [
        "Daily",
        "Weekly",
        "Monthly",
        "Quarterly",
        "OnCompletion",
        "OnDemand"
      ],
      "x-enum": "ReportingFrequency",
      "x-source": "user"
    },
    "BillingMethod": {
      "type": "string",
      "enum": [
        "MonthlyFixed",
        "MeasuredBOQ",
        "LumpSumMilestone",
        "OnCompletion",
        "TimeAndMaterial"
      ],
      "x-enum": "BillingMethod",
      "x-source": "user"
    },
    "ContractValue": {
      "type": "string",
      "x-decimal-scale": 3,
      "x-storage": "decimal string; never a float (spec 11)",
      "x-source": "user"
    },
    "Status": {
      "type": "string",
      "x-source": "user",
      "description": "Validation: Draft|Active|Suspended|Completed|Terminated"
    },
    "Version": {
      "type": "integer",
      "x-source": "system"
    },
    "IsActive": {
      "type": "boolean",
      "x-source": "user",
      "description": "Soft delete. Rows are never hard-deleted; history is evidence."
    },
    "CreatedAt": {
      "type": "string",
      "x-source": "system",
      "description": "UTC. Set once on insert."
    },
    "CreatedBy": {
      "type": "string",
      "x-source": "system",
      "description": "USEREMAIL() or the service identity."
    },
    "UpdatedAt": {
      "type": "string",
      "x-source": "system",
      "description": "UTC. Excluded from ContentHash."
    },
    "UpdatedBy": {
      "type": "string",
      "x-source": "system"
    }
  },
  "required": [
    "ContractID",
    "LegalEntityID",
    "ClientID",
    "ContractNumber",
    "EffectiveDate",
    "Currency",
    "PaymentTermsDays",
    "BillingMethod",
    "Status",
    "Version",
    "IsActive",
    "CreatedAt",
    "CreatedBy",
    "UpdatedAt",
    "UpdatedBy"
  ],
  "additionalProperties": false
}
