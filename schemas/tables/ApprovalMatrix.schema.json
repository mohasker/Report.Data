{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alharam.local/schemas/tables/ApprovalMatrix.schema.json",
  "title": "ApprovalMatrix",
  "description": "Who approves what, per project and stage (D-09, D-15 item 6). The GM is the MVP approver, and the structure supports delegation without redesign.",
  "x-description-ar": "مصفوفة الاعتمادات",
  "x-category": "master",
  "x-scope": "project",
  "x-sensitivity": "internal",
  "x-built-in-phase": 1,
  "x-primary-key": "ApprovalMatrixID",
  "x-content-hash-fields": [],
  "x-unique-together": [],
  "x-at-least-one": [],
  "x-notes": [],
  "type": "object",
  "properties": {
    "ApprovalMatrixID": {
      "type": "string"
    },
    "ProjectID": {
      "type": "string",
      "x-references": "Projects.ProjectID",
      "x-source": "user",
      "description": "Null means the company-wide default for this stage. References Projects.ProjectID"
    },
    "ApprovalStage": {
      "type": "string",
      "enum": [
        "EvidenceReview",
        "TechnicalReview",
        "FinanceReview",
        "Release",
        "OverrideAuthorisation"
      ],
      "x-enum": "ApprovalStage",
      "x-source": "user"
    },
    "DocumentTypeCode": {
      "type": "string",
      "enum": [
        "DailyReport",
        "WeeklyReport",
        "MonthlyTechnicalReport",
        "InspectionReport",
        "CorrectiveActionReport",
        "Quotation",
        "CompletionCertificate",
        "InvoiceCover",
        "Transmittal"
      ],
      "x-enum": "DocumentTypeCode",
      "x-source": "user",
      "description": "Null applies to every document type."
    },
    "ResponsibleUserID": {
      "type": "string",
      "x-references": "Users.UserID",
      "x-source": "user",
      "description": "The accountable approver. A delegate acts FOR this person, never instead of them. References Users.UserID"
    },
    "BackupUserID": {
      "type": "string",
      "x-references": "Users.UserID",
      "x-source": "user",
      "description": "May remain unassigned until before go-live (D-09). References Users.UserID"
    },
    "SequenceNumber": {
      "type": "integer",
      "x-source": "user",
      "description": "Supports multi-step approval within a stage."
    },
    "SelfApprovalProhibited": {
      "type": "boolean",
      "x-source": "config",
      "description": "No user may approve their own restricted transaction because an approver is unavailable (D-09). This is not configurable to FALSE for financial stages."
    },
    "IsActive": {
      "type": "boolean",
      "x-source": "user",
      "description": "Soft delete. Rows are never hard-deleted; history is evidence."
    },
    "CreatedAt": {
      "type": "string",
      "x-source": "system",
      "description": "UTC. Set once on insert."
    },
    "CreatedBy": {
      "type": "string",
      "x-source": "system",
      "description": "USEREMAIL() or the service identity."
    },
    "UpdatedAt": {
      "type": "string",
      "x-source": "system",
      "description": "UTC. Excluded from ContentHash."
    },
    "UpdatedBy": {
      "type": "string",
      "x-source": "system"
    }
  },
  "required": [
    "ApprovalMatrixID",
    "ApprovalStage",
    "ResponsibleUserID",
    "SequenceNumber",
    "SelfApprovalProhibited",
    "IsActive",
    "CreatedAt",
    "CreatedBy",
    "UpdatedAt",
    "UpdatedBy"
  ],
  "additionalProperties": false
}
