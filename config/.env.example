# Al-Haram Field Reporting System — configuration variable NAMES only.
#
# THIS FILE CONTAINS NO VALUES, AND NEVER WILL.
#
# Copy to .env locally if a tool ever needs it. .env is git-ignored.
# Secrets are never stored here even locally: they live in the provider's own
# connection store, authorised by the owner personally in each provider's console
# (operating rule 4, D-14).
#
# Phase 1 requires none of these. Everything below is needed by a later phase,
# and each is tracked in docs/01-data-foundation/16-external-facts-register.md.

# ---- Google Workspace and storage (Phase 2-3) ----
GOOGLE_WORKSPACE_DOMAIN=
SYSTEM_OWNER_ACCOUNT=
SHARED_DRIVE_ID=
DRIVE_ROOT_FOLDER_ID=
OPERATIONS_SPREADSHEET_ID=

# ---- Capture platform (Phase 2-3) ----
APPSHEET_APP_ID=
APPSHEET_PLAN_TIER=
APPSHEET_DEEPLINK_BASE=
# APPSHEET_API_KEY        -> connection store only, never here
# APPSHEET_WEBHOOK_SECRET -> connection store only, never here

# ---- Orchestration (Phase 3) ----
MAKE_ORGANIZATION=
MAKE_TEAM=
MAKE_DATASTORE_IDEMPOTENCY=
MAKE_DATASTORE_COUNTERS=
MAKE_ERROR_QUEUE_TARGET=
# MAKE_WEBHOOK_URLS -> connection store only; possession permits invocation

# ---- AI (Phase 4) ----
CLAUDE_WORKSPACE=
CLAUDE_MONTHLY_SPEND_CAP=
CLAUDE_MODEL_EVIDENCE=
CLAUDE_MODEL_NARRATIVE=
CLAUDE_MAX_OUTPUT_TOKENS=
# CLAUDE_API_KEY -> connection store only, never here

# ---- Accounting (Phase 7) ----
QBO_COMPANY_ID=
QBO_REGION_EDITION=
QBO_SANDBOX_COMPANY_ID=
QBO_POSTING_ENABLED=FALSE
# QBO_OAUTH_CONNECTION -> connection store only, never here

# ---- Operational policy (maintained as master data, not as env vars) ----
# Legal entity, tax rules, approval matrix, numbering series, residency rules,
# retention, recipients and templates are ADMINISTERED IN THE APPLICATION.
# They are listed in docs/00-discovery/09-configuration-register.md and are not
# environment variables, because requirement 14 says adding or changing a project
# must never require touching configuration files or code.
