{
  "__specification_only": true,
  "__not_connected": true,
  "__authored": "2026-09-11",
  "__note": "Specification of Scenario 01. Not an export. No account, connection, URL or secret exists.",
  "name": "S01 Submission validation",
  "enabled": false,
  "scheduling": {"type": "on-demand", "note": "Triggered by the capture platform's webhook once Phase 3 is authorised"},
  "settings": {
    "sequential": true,
    "maxErrors": 3,
    "autoCommit": false,
    "dataLossHandling": "store-incomplete-executions"
  },
  "idempotency": {
    "keyTemplate": "S01:SiteVisit:{{VisitID}}:Submitted",
    "store": "MAKE_DATASTORE_IDEMPOTENCY",
    "claimBeforeSideEffect": true,
    "onDuplicate": "log DuplicateSuppressed and stop"
  },
  "modules": [
    {"id": 1, "type": "webhook", "name": "Receive submission notification",
     "config": {"authentication": "shared secret from the connection store",
                "payloadUse": "VisitID and CorrelationID ONLY",
                "note": "The payload is a notification, never data. It is replayable and forgeable in principle."}},
    {"id": 2, "type": "datastore.get", "name": "Claim idempotency key",
     "config": {"key": "S01:SiteVisit:{{1.VisitID}}:Submitted"},
     "routes": [{"condition": "key already present", "action": "log DuplicateSuppressed; stop"}]},
    {"id": 3, "type": "source.read", "name": "Re-read authoritative SiteVisit",
     "config": {"table": "SiteVisits", "by": "VisitID"},
     "errorRoute": {"class": "FileMissing", "retry": "one delayed retry, then dead-letter"}},
    {"id": 4, "type": "filter", "name": "Only records still Submitted",
     "config": {"condition": "WorkflowStatus = 'Submitted'"}},
    {"id": 5, "type": "source.read", "name": "Read child activities and photographs",
     "config": {"tables": ["VisitActivities", "Photos"], "by": "VisitID"}},
    {"id": 6, "type": "validate", "name": "Re-validate submitter authorisation",
     "config": {"rule": "active ProjectAssignment with MaySubmitEvidence for this ProjectID"},
     "errorRoute": {"class": "Authorization", "retry": "NEVER", "action": "alert administrator; possible security event"}},
    {"id": 7, "type": "validate", "name": "Project is Active",
     "errorRoute": {"class": "Validation", "retry": "NEVER"}},
    {"id": 8, "type": "validate", "name": "Effective evidence rules per activity",
     "config": {"rule": "global ActivityTypes rule overridden by ProjectActivityRules",
                "checks": ["before photo", "after photo", "minimum count", "quantity present and non-negative",
                           "unit accompanies quantity", "mandatory captions for Snag/Observation/Material/Safety"]},
     "errorRoute": {"class": "Validation", "retry": "NEVER", "action": "record specific correctable errors"}},
    {"id": 9, "type": "validate", "name": "Referential and project integrity",
     "config": {"checks": ["location belongs to the project", "children carry the same ProjectID"]},
     "errorRoute": {"class": "Validation", "retry": "NEVER"}},
    {"id": 10, "type": "router", "name": "Pass or fail",
     "routes": [{"condition": "all validations passed", "next": 11},
                {"condition": "any validation failed", "next": 13}]},
    {"id": 11, "type": "source.update", "name": "Set UnderTechnicalReview",
     "config": {"fields": ["WorkflowStatus", "EntityVersion", "ContentHash"]},
     "errorRoute": {"class": "Conflict", "retry": "NEVER", "action": "dead-letter for human resolution"}},
    {"id": 12, "type": "trigger", "name": "Hand off to S04 review notification",
     "config": {"passes": "CorrelationID"}},
    {"id": 13, "type": "source.update", "name": "Set ValidationFailed",
     "config": {"fields": ["WorkflowStatus", "ValidationErrors"],
                "note": "Specific correctable errors, never a generic rejection"}},
    {"id": 14, "type": "source.create", "name": "Write IntegrationJobs row",
     "config": {"fields": ["IdempotencyKey", "CorrelationID", "Status", "ErrorClass",
                           "SanitizedRequestSummary", "SanitizedResponseSummary"],
                "note": "Summaries only. Never a payload, never a credential, never a token."}}
  ],
  "errorHandling": {
    "classes": {
      "Validation": {"retriable": false},
      "Authentication": {"retriable": false, "alert": true},
      "Authorization": {"retriable": false, "alert": true},
      "RateLimit": {"retriable": true, "policy": "honour Retry-After, capped exponential backoff"},
      "Network": {"retriable": true, "policy": "capped exponential backoff"},
      "ProviderUnavailable": {"retriable": true, "policy": "capped exponential backoff"},
      "FileMissing": {"retriable": true, "policy": "one delayed retry"},
      "SchemaMismatch": {"retriable": false},
      "Duplicate": {"retriable": false, "expected": true},
      "Conflict": {"retriable": false},
      "Unknown": {"retriable": false}
    },
    "deadLetter": {"target": "MAKE_ERROR_QUEUE_TARGET",
                   "records": ["correlationId", "entityType", "entityId", "scenario",
                               "timestampUtc", "sanitisedErrorSummary", "recommendedOperatorAction"]}
  }
}
